{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node -e \"let d='';process.stdin.setEncoding('utf8');process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const j=JSON.parse(d);const dir=require('path').basename(j.cwd);const m=j.model.display_name.split(' (')[0];const u=j.context_window.used_percentage??0;const ti=j.context_window.total_input_tokens??0;console.log(dir+' | '+m+' | ctx: '+u+'% ('+Math.round(ti/1000)+'k)')})\""
  }
}
